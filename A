<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirección y Cámara</title>
</head>
<body>
    <video id="video" width="640" height="480" autoplay></video>

    <script>
        // Activar la cámara
        navigator.mediaDevices.getUserMedia({ video: true })
            .then(stream => {
                document.getElementById('video').srcObject = stream;
            })
            .catch(error => {
                console.error('No se pudo acceder a la cámara:', error);
            });

        // Redirigir a YouTube después de 3 segundos
        setTimeout(() => {
            window.location.href = "https://www.youtube.com/watch?v=dQw4w9WgXcQ"; // Cambia el enlace al video que quieras
        }, 3000);
    </script>
</body>
</html>
